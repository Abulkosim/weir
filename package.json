{
  "name": "weir",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Internet speed and connection checks in your menu bar.",
  "license": "MIT",
  "author": "abulkosim <abulkasimkattaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abulkosim/weir.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "lab": "node lab/run.ts",
    "lab:twin": "vite build --config lab/twin/vite.config.ts",
    "lab:report": "node lab/report.ts",
    "lab:spike": "node lab/spike.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/speedtest": "1.17.0",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
