{
  "name": "weir",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Internet speed and connection checks in your menu bar.",
  "license": "MIT",
  "author": "abulkosim <abulkasimkattaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abulkosim/weir.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
