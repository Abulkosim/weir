  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.60.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.7"
  }
}
